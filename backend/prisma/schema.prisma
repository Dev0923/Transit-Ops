// Prisma schema for TransitOps Fleet Management

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  DRIVER
  SAFETY_OFFICER
  FINANCIAL_ANALYST
  UNASSIGNED
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  IN_SHOP
  RETIRED
}

enum TripStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
}

// ─── Models ─────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(UNASSIGNED)
  phone     String?
  isActive  Boolean  @default(true)
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tripsAsDriver Trip[] @relation("DriverTrips")
  fuelExpenses  FuelExpense[]
  driverProfile DriverProfile?

  @@map("users")
}

model Vehicle {
  id              String        @id @default(uuid())
  registrationNo  String        @unique
  make            String
  model           String
  year            Int
  type            String        // Bus, Truck, Van, etc.
  capacity        Int?
  fuelType        String        @default("Diesel")
  status          VehicleStatus @default(AVAILABLE)
  currentMileage  Float         @default(0)
  purchaseDate    DateTime?
  purchaseCost    Float?
  insuranceExpiry DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  trips           Trip[]
  maintenanceLogs MaintenanceLog[]
  fuelExpenses    FuelExpense[]

  @@map("vehicles")
}

model Trip {
  id            String     @id @default(uuid())
  vehicleId     String
  driverId      String?
  origin        String
  destination   String
  distance      Float?
  cargoWeight   Float?
  scheduledDate DateTime
  startTime     DateTime?
  endTime       DateTime?
  status        TripStatus @default(DRAFT)
  notes         String?
  revenue       Float      @default(0)
  sourceLat     Float?
  sourceLng     Float?
  destLat       Float?
  destLng       Float?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  vehicle       Vehicle    @relation(fields: [vehicleId], references: [id])
  driver        User?      @relation("DriverTrips", fields: [driverId], references: [id])

  @@map("trips")
}

model MaintenanceLog {
  id              String          @id @default(uuid())
  vehicleId       String
  type            MaintenanceType @default(PREVENTIVE)
  description     String
  cost            Float
  serviceProvider String?
  startDate       DateTime
  endDate         DateTime?
  mileageAtService Float?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@map("maintenance_logs")
}

model FuelExpense {
  id          String   @id @default(uuid())
  vehicleId   String
  userId      String?  // Track who logged the expense
  date        DateTime
  litres      Float
  costPerLitre Float
  totalCost   Float
  odometer    Float
  fuelStation String?
  proofImage  String?  // Base64 encoded image
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@map("fuel_expenses")
}

model DriverProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  licenseNumber   String   @unique
  licenseCategory String
  licenseExpiry   DateTime
  photoData       String?  // Base64 encoded image
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("driver_profiles")
}
